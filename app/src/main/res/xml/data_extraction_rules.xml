<?xml version="1.0" encoding="utf-8"?>
<!-- Keep API keys and OAuth tokens out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="opus_secure_settings.xml" />
        <exclude domain="sharedpref" path="opus_api_settings.xml" />
        <exclude domain="sharedpref" path="opus_direct_platform_apis.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="opus_secure_settings.xml" />
        <exclude domain="sharedpref" path="opus_api_settings.xml" />
        <exclude domain="sharedpref" path="opus_direct_platform_apis.xml" />
    </device-transfer>
</data-extraction-rules>
